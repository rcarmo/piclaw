{
  "name": "piclaw-e2e",
  "private": true,
  "scripts": {
    "setup": "bun run setup/configure-test-instance.ts",
    "setup:github": "bun run setup/configure-github-models.ts",
    "validate": "bun run setup/validate-test-config.ts",
    "test": "bun ../../runtime/scripts/local-test-priority.ts -- bunx playwright test",
    "test:compose": "bun ../../runtime/scripts/local-test-priority.ts -- bunx playwright test steps/us02-*",
    "test:timeline": "bun ../../runtime/scripts/local-test-priority.ts -- bunx playwright test steps/timeline-*",
    "test:sessions": "bun ../../runtime/scripts/local-test-priority.ts -- bunx playwright test steps/us03-* steps/us09-*",
    "test:settings": "bun ../../runtime/scripts/local-test-priority.ts -- bunx playwright test steps/us06-*",
    "test:editor": "bun ../../runtime/scripts/local-test-priority.ts -- bunx playwright test steps/us04-*",
    "test:mobile": "bun ../../runtime/scripts/local-test-priority.ts -- bunx playwright test --project=ipad --project=iphone --project=android-chrome",
    "test:android": "bun ../../runtime/scripts/local-test-priority.ts -- bunx playwright test --project=android-chrome",
    "test:reconnect": "bun ../../runtime/scripts/local-test-priority.ts -- bunx playwright test steps/us07-*",
    "test:smoke": "bun ../../runtime/scripts/local-test-priority.ts -- bunx playwright test steps/us01-*",
    "report": "bun run scripts/generate-report.ts",
    "report:html": "playwright show-report reports/html"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@cucumber/cucumber": "^13.3.0",
    "playwright-bdd": "^9.2.1"
  }
}
